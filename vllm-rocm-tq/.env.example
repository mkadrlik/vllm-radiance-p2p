# vllm-rocm-tq — AWQ Inference Server Environment Variables
# Copy to .env and fill in values. Never commit .env.

# HuggingFace token (required for gated models)
HF_TOKEN=

# GPU to use (default: 0)
GPU_ID=0

# Model to serve (default: Qwen2.5-0.5B-Instruct-AWQ)
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct-AWQ

# Custom served model name (optional)
SERVED_MODEL_NAME=

# Quantization type (default: awq)
QUANTIZATION=awq

# Maximum model context length
MAX_MODEL_LEN=32768

# GPU memory utilization (0.0–1.0)
GPU_MEMORY_UTILIZATION=0.85

# Tensor parallel size (default: 1)
TENSOR_PARALLEL_SIZE=1

# Additional vLLM args (space-separated, optional)
VLLM_EXTRA_ARGS=

# Host port mapping (container port is always 8001)
VLLM_HOST_PORT=13309

# Custom vLLM image (optional, default: ghcr.io/mkadrlik/vllm-rocm-tq:latest)
VLLM_TQ_IMAGE=
