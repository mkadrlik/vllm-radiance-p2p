# vLLM + Radiance TP2 P2P — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# HuggingFace token (required for model download)
HF_TOKEN=

# vLLM API key (optional, for authentication)
VLLM_35B_API_KEY=

# Model name (override to serve a different model)
MODEL_NAME=

# Tensor parallel size (number of GPUs)
TENSOR_PARALLEL_SIZE=2

# GPU memory utilization (0.0–1.0)
GPU_MEMORY_UTILIZATION=0.92

# Maximum model context length
MAX_MODEL_LEN=32768

# Host port mapping (container port is always 13313)
VLLM_HOST_PORT=13313
