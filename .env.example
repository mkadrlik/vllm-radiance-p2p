# vLLM + Radiance TP2 P2P — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# HuggingFace token (required for model download)
HF_TOKEN=

# Model name (override to serve a different model)
MODEL_NAME=

# Tensor parallel size (number of GPUs)
TENSOR_PARALLEL_SIZE=2

# GPU memory utilization (0.0–1.0)
GPU_MEMORY_UTILIZATION=0.92

# Maximum model context length
MAX_MODEL_LEN=32768

# Host port mapping (container port is always 13313)
VLLM_HOST_PORT=13313

# ── Radiance (27B / 35B) ──────────────────────────────────────────

# HIP_VISIBLE_DEVICES (comma-separated GPU indices)
HIP_VISIBLE_DEVICES=0,1

# Shm size for TP2 (default 16G)
VLLM_SHM_SIZE=16G

# GPU memory utilization per model
VLLM_27B_GPU_MEM_UTIL=0.85
VLLM_35B_GPU_MEM_UTIL=0.85

# Max context length per model
VLLM_27B_MAX_MODEL_LEN=65537
VLLM_35B_MAX_MODEL_LEN=32768

# Batch tokens / max sequences
VLLM_BATCH_TOKENS=2048
VLLM_MAX_SEQS=64

# TorchInductor compile threads
TORCHINDUCTOR_COMPILE_THREADS=4

# Health check tuning
VLLM_START_PERIOD=1800
VLLM_HEALTH_RETRIES=10

# ── AWQ ───────────────────────────────────────────────────────────

# GPU ID for AWQ
AWQ_GPU_ID=0

# HSA override (RDNA3)
HSA_OVERRIDE_GFX_VERSION=11.0.0
HSA_SIGNAL_TIMEOUT=-1
AMDGPU_GPU_RECOVERY=1

# AWQ host port
AWQ_HOST_PORT=13309
AWQ_CONTAINER_PORT=8001

# AWQ model name
AWQ_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct-AWQ
AWQ_SERVED_MODEL_NAME=Qwen2.5-0.5B-Instruct
