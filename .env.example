# vLLM on AMD RDNA3 (gfx1100) — environment
#
# Copy to .env and edit:   cp .env.example .env
# docker compose reads .env automatically from the project directory.
# Never commit .env.

# ── Required ───────────────────────────────────────────────────────
# HuggingFace token — needed once, to download the gated model weights
# into ./data/cache. Get one at https://huggingface.co/settings/tokens
# (you must also accept the model's license terms on its HF page).
HF_TOKEN=

# ── Container images ───────────────────────────────────────────────
# Prebuilt gfx1100 image for the radiance-27b / radiance-35b profiles.
# Pull is automatic on first `up`. Override only if you build your own.
RADIANCE_IMAGE=ghcr.io/mkadrlik/vllm-radiance-p2p:gfx1100

# Tag used by the `awq` profile, which builds locally from Dockerfile.awq
# on first `up` (base image is the public vllm/vllm-openai-rocm:v0.24.0).
AWQ_IMAGE=vllm-radiance-p2p-awq:latest

# ── Shared (radiance profiles) ─────────────────────────────────────
# Host port the API is published on (container port is always 13313).
VLLM_HOST_PORT=13313

# GPU indices for tensor parallel 2. Must be two cards on the same
# PCIe root complex for P2P (see AGENTS.md → P2P on gfx1100).
HIP_VISIBLE_DEVICES=0,1

# Number of GPUs (tensor-parallel size).
TENSOR_PARALLEL_SIZE=2

# Shared-memory size for TP2.
VLLM_SHM_SIZE=16G

# Per-model KV-cache budget (fraction of each GPU).
VLLM_27B_GPU_MEM_UTIL=0.85
VLLM_35B_GPU_MEM_UTIL=0.85

# Context length per model. DO NOT raise 35B above 32768 — it OOMs at TP2.
VLLM_27B_MAX_MODEL_LEN=65537
VLLM_35B_MAX_MODEL_LEN=32768

# Scheduler sizing.
VLLM_BATCH_TOKENS=2048
VLLM_MAX_SEQS=64

# TorchInductor compile worker threads.
TORCHINDUCTOR_COMPILE_THREADS=4

# Healthcheck: first boot compiles kernels, so the start period is long.
VLLM_START_PERIOD=1800
VLLM_HEALTH_RETRIES=10

# ── AWQ profile (single GPU) ───────────────────────────────────────
AWQ_GPU_ID=0
AWQ_HOST_PORT=13309
AWQ_CONTAINER_PORT=8001

# Any AWQ-quantized model on HuggingFace.
AWQ_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct-AWQ
AWQ_SERVED_MODEL_NAME=Qwen2.5-0.5B-Instruct

# AWQ tuning.
QUANTIZATION=awq
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.85

# RDNA3 (gfx1100) ROCm compatibility knobs.
HSA_OVERRIDE_GFX_VERSION=11.0.0
HSA_SIGNAL_TIMEOUT=-1
AMDGPU_GPU_RECOVERY=1

# Extra vLLM flags appended verbatim to the AWQ command (optional).
VLLM_EXTRA_ARGS=
